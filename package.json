{
  "name": "action-parity-probe-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config site/vite.config.js",
    "generate:demo": "node scripts/generate-demo.mjs && node scripts/generate-terminal-recording.mjs",
    "build:site": "vite build --config site/vite.config.js",
    "build": "npm run generate:demo && npm run build:site",
    "preview": "vite preview --config site/vite.config.js",
    "test": "npm run build && cargo test && playwright test",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "vite": "7.3.6"
  },
  "engines": {
    "node": ">=20"
  }
}
